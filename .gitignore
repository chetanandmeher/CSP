# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this can be ignored.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing pipenv in a virtualenv, it may write to a global directory.
#   For this, we can ignore the virtualenv folder:
#   .venv/

# Poetry
#   Poetry creates virtualenvs outside the project by default, but if you configured it
#   to create virtualenvs in the project folder, it is under .venv/
.venv/
poetry.lock.bak

# pdm
#   Similar to Poetry, pdm creates virtualenvs or __pypackages__ in the project folder
.pdm-plugins/
__pypackages__/

